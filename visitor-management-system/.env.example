# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Neon Postgres. Use the POOLED connection string for the app (DATABASE_URL)
# and the DIRECT (non-pooled) string for migrations (DIRECT_URL).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/vms?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/vms?sslmode=require"

# Vercel Blob — Read/Write token from the Vercel dashboard (Storage → Blob).
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxx"

# Upstash Redis (REST) — from the Upstash console.
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxxxxx"

# NextAuth v5 — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
# Canonical site URL — used to build password-reset links and as the OAuth
# callback base. Vercel/production: your real domain.
AUTH_URL="http://localhost:3000"

# Google OAuth (Admin/Staff sign-in only — see auth.ts). Create an OAuth
# Client in Google Cloud Console → APIs & Services → Credentials, and add
# these Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google   (dev)
#   https://<your-domain>/api/auth/callback/google    (prod)
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="xxxxxxxx"
# Only this email domain may sign in via Google, and only if an Admin has
# already created a matching HEAD/STAFF account (no auto-provisioning).
ALLOWED_GOOGLE_DOMAIN="thapar.edu"

# AWS SES — sender identity must be verified in the SES console (and the
# account must have production access, or the recipient must also be
# verified, if SES is still in the sandbox).
SES_FROM_EMAIL="no-reply@yourdomain.edu"

# Secret header required by the VIP-expiry cron endpoint
# (app/api/cron/expire-vip). Required in production — the route rejects all
# requests without it.
CRON_SECRET="replace-me-with-a-random-string"

# ---------------------------------------------------------------------------
# SMS OTP Provider Settings
# ---------------------------------------------------------------------------
# The visitor check-in requires a real OTP sent to the phone. In production
# (NODE_ENV=production) Upstash Redis MUST be configured above — OTP codes are
# stored there, and /api/otp/request returns 500 without it. The dev-only test
# bypass (master code 123456 + on-screen code hint) is automatically disabled
# outside NODE_ENV=production.
ENABLE_REAL_SMS="true" # Set to "true" to send real SMS; "false" for local dev console fallback
SMS_PROVIDER="twilio"  # Supported options: twilio | fast2sms | msg91 | aws_sns

# Twilio (Primary) — from console.twilio.com after signing up at twilio.com/try-twilio.
# NOTE: on a FREE TRIAL account Twilio only delivers to phone numbers you have
# verified in the console (Phone Numbers → Verified Caller IDs). To send to any
# number you must upgrade the Twilio account (paid). TWILIO_PHONE_NUMBER is the
# trial "from" number Twilio assigns you, in E.164 form (e.g. +15551234567).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# Twilio Verify Service SID (VA...) — create at console.twilio.com → Verify →
# Services. When set, OTP send + check is delegated to Twilio Verify (works on
# trial accounts, which block custom SMS bodies). Recommended for Twilio.
TWILIO_VERIFY_SERVICE_SID=""

# Fast2SMS (Alternative for India — Quick SMS route needs a one-time ₹100 recharge)
FAST2SMS_API_KEY=""

# MSG91 (Alternative for India — requires DLT sender-ID + template approval)
MSG91_AUTH_KEY="your_msg91_auth_key"
MSG91_TEMPLATE_ID="your_msg91_dlt_template_id"

# AWS SNS (Alternative)
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# WhatsApp OTP Provider Settings
# ---------------------------------------------------------------------------
# Visitors can receive OTP verification via WhatsApp (default) or SMS.
# Supported WhatsApp providers: "twilio" | "meta"
WHATSAPP_PROVIDER="twilio"

# Twilio WhatsApp Sender Number
# For Sandbox testing, use: "whatsapp:+14155238886"
# For live production, use your Twilio WhatsApp enabled number: "whatsapp:+1..."
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# Meta WhatsApp Cloud API (Alternative direct Meta Graph API integration)
# WHATSAPP_ACCESS_TOKEN="your_meta_system_user_access_token"
# WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"


