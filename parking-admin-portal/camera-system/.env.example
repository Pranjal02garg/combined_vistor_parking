# ==============================================================================
# Smart Parking & ANPR Camera System Environment Configuration (.env)
# Copy this file to '.env' in this directory and update values as needed.
# ==============================================================================

# ── MongoDB Connection ────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=Pilot
MONGODB_DB_NAME=parking_app

# ── ANPR Camera Settings ──────────────────────────────────────────────────────
# Main camera host/IP (used by single camera setup & plate sync worker)
CAM_HOST=192.168.1.2

# Dual-camera setup specific IP addresses
ENTRY_CAM_IP=172.31.172.32
EXIT_CAM_IP=172.31.172.31

# Camera HTTP Digest Auth credentials
CAM_USER=admin
CAM_PASS=admin

# ── RTSP Video Stream & Barrier API (AI Detection) ───────────────────────────
CAMERA_URL=rtsp://admin:admin@192.168.1.250:554/rtsp/streaming?channel=01&subtype=1
BARRIER_API_KEY=Pilot@Parking
BARRIER_UP_API=http://10.68.88.92:5000/barrier/up?key=Pilot@Parking
BARRIER_DOWN_API=http://10.68.88.92:5000/barrier/down?key=Pilot@Parking
ALLOWED_PLATES_API=https://admin-portal-sigma-oene.vercel.app/api/allowed-plates

# ── Polling & Retries ────────────────────────────────────────────────────────
POLL_INTERVAL_SEC=3
HEARTBEAT_INTERVAL_SEC=10
MAX_RETRIES=5

# ── Kiosk Display & Jetson Servers ───────────────────────────────────────────
DISPLAY_API_HOST=0.0.0.0
DISPLAY_API_PORT=5055
TOTAL_PARKING_SLOTS=100

JETSON_SERVER_HOST=0.0.0.0
JETSON_SERVER_PORT=5000

# ── Camera API Endpoints (Optional Overrides) ─────────────────────────────────
# CAM_DELETE_PATH=/API/AI/Plates/Remove
