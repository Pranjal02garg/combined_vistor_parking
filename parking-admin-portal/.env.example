MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?appName=Pilot
MONGODB_DB_NAME=parking_app

# ── ANPR Camera Settings ──────────────────────────────────────────────────────
# Main camera host/IP (used by single camera setup & plate sync worker)
CAM_HOST=<main_camera_ip>

# Dual-camera setup specific IP addresses
ENTRY_CAM_IP=<entry_camera_ip>
EXIT_CAM_IP=<exit_camera_ip>

# Camera HTTP Digest Auth credentials
CAM_USER=admin
CAM_PASS=<your_camera_password>

# ── RTSP Video Stream & Barrier API (AI Detection) ───────────────────────────
CAMERA_URL=rtsp://<username>:<password>@<camera_ip>:554/rtsp/streaming?channel=01&subtype=1
BARRIER_API_KEY=<your_api_key>
BARRIER_UP_API=http://<barrier_api_ip>:5000/barrier/up?key=<your_api_key>
BARRIER_DOWN_API=http://<barrier_api_ip>:5000/barrier/down?key=<your_api_key>
ALLOWED_PLATES_API=https://<your_domain>/api/allowed-plates

# ── Polling & Retries ────────────────────────────────────────────────────────
POLL_INTERVAL_SEC=3
HEARTBEAT_INTERVAL_SEC=10
MAX_RETRIES=5

# ── Kiosk Display & Jetson Servers ───────────────────────────────────────────
DISPLAY_API_HOST=0.0.0.0
DISPLAY_API_PORT=5055
TOTAL_PARKING_SLOTS=100

JETSON_SERVER_HOST=0.0.0.0
JETSON_SERVER_PORT=5000

# ── Camera API Endpoints (Optional Overrides) ─────────────────────────────────
# CAM_DELETE_PATH=/API/AI/Plates/Remove